{
  "expo": {
    "name": "ZeitApp",
    "slug": "zeitapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/timeapp-icon.png",
    "scheme": "zeitapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false ,
      "bundleIdentifier": "com.zeitappteams.zeitapp"
    },
    "android": {"package": "com.zeitappteams.zeitapp"},
    "web": {
      "name": "ZeitApp",
      "shortName": "ZeitApp",
      "lang": "de-DE",
      "themeColor": "#102C3A",
      "backgroundColor": "#F5F7F8",
      "favicon": "./assets/images/timeapp-icon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "be3a85b6-d78d-4322-a35c-42358a4f3784"
      }
    },
    "owner": "zeitappteams"
  }
}
